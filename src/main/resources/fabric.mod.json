{
  "schemaVersion": 1,
  "id": "ichunutil",
  "version": "${version}",

  "name": "iChunUtil",
  "description": "Shared library mod required by most of iChun's Mods.",
  "authors": [
    "iChun"
  ],
  "contact": {
    "homepage": "https://www.curseforge.com/members/ohaiichun/projects",
    "sources": "https://github.com/iChun/iChunUtil",
    "issues": "https://github.com/iChun/iChunUtil/issues"
  },

  "license": "GNU Lesser General Public License v3.0",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "me.ichun.mods.ichunutil.loader.fabric.LoaderFabric"
    ],
    "client": [
      "me.ichun.mods.ichunutil.loader.fabric.client.LoaderFabricClient"
    ],
    "modmenu": [
      "me.ichun.mods.ichunutil.loader.fabric.client.ModMenuIntegration"
    ]
  },

  "mixins": [
    "ichunutil.mixins.json"
  ],

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/wvxVkmpt3g"
      }
    }
  },

  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": ">=1.20.6 <1.21",
    "java": ">=21"
  }
}

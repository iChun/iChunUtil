{
  "schemaVersion": 1,
  "id": "ichunutil",
  "version": "${mod_version}",

  "name": "iChunUtil",
  "description": "${mod_description}",
  "authors": [
    "iChun"
  ],
  "contact": {
    "homepage": "${mod_url_home}",
    "sources": "${mod_url_sources}",
    "issues": "${mod_url_issues}"
  },

  "license": "${mod_license}",
  "icon": "icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "me.ichun.mods.ichunutil.loader.fabric.LoaderFabric"
    ],
    "client": [
      "me.ichun.mods.ichunutil.loader.fabric.client.LoaderFabricClient"
    ],
    "modmenu": [
      "me.ichun.mods.ichunutil.loader.fabric.client.ModMenuIntegration"
    ]
  },

  "accessWidener" : "ichunutil.accesswidener",
  "mixins": [
    "ichunutil.mixins.json"
  ],

  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "${mod_url_discord}"
      }
    }
  },

  "depends": {
    "fabricloader": ">=0.15.0",
    "fabric-api": "*",
    "minecraft": ">=1.19 <=1.19.2",
    "java": ">=17"
  }
}
